# Скопируйте этот файл в .env и впишите свои значения. Файл .env никуда не загружайте.

# Токен бота из кабинета MAX для партнёров (обязательно)
BOT_TOKEN=

# Ключ ИИ-сервиса (обязательно)
AI_API_KEY=

# Адрес и модель ИИ — подойдёт любой OpenAI-совместимый сервис (необязательно)
AI_BASE_URL=
AI_MODEL=

# Где хранить базу. В Docker уже настроено (/data/svodka.db), локально по умолчанию svodka.db
# DB_PATH=svodka.db

# Код учителя. Кто введёт его боту (кнопка «Я учитель»), сможет подтверждать записи.
# Пусто — подтверждать может только владелец чата. Придумайте длинный код и выдайте его учителям.
TEACHER_CODE=

# Расшифровка голосовых.
# chat    — модель с входом «Аудио» (glm-5.3-flash, mimo-v2.6-flash, gemini-3.8-flash…): запрос как к чату
# whisper — отдельный метод распознавания речи, если он есть у вашего сервиса
STT_MODE=chat
STT_MODEL=
# false — выключить расшифровку голосовых
STT_ENABLED=true

# Чтение фото с домашкой: hinted — если рядом есть подсказка про ДЗ (по умолчанию), all — каждое фото, off — не читать
PHOTO_SCAN=hinted
# Модель с входом «Изображение»
VISION_MODEL=

# История при добавлении бота: сколько дней читать и потолки одного чтения (чтобы не тратить много токенов)
HISTORY_DAYS=7
HISTORY_MAX_MESSAGES=300
HISTORY_MAX_PLANS=40
HISTORY_MAX_PHOTOS=5

# false — выключить вечернюю сводку и утренние напоминания
DIGEST_ENABLED=true
CONTEXT_TTL_S=600